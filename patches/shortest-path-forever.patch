diff --git a/UI/Settings.lua b/UI/Settings.lua
index 234a549..02f1cb6 100644
--- a/UI/Settings.lua
+++ b/UI/Settings.lua
@@ -251,6 +251,53 @@ ns.Init(function()
 	host.OnAttachmentChanged(function()
 		Settings.NotifyUpdate(variable)
 	end)
+	-- Questie hides the game's quest tracker and lists the quests in its own, so with Questie installed the player
+	-- picks which of the two the column attaches to. One dropdown, so the two are never both chosen. A ForeverCore
+	-- older than the choice has no SetTarget, and the row is left out.
+	local function QuestieEnabled()
+		if not C_AddOns then
+			return false
+		end
+		if C_AddOns.IsAddOnLoaded and C_AddOns.IsAddOnLoaded("Questie") then
+			return true
+		end
+		if not (C_AddOns.DoesAddOnExist and C_AddOns.DoesAddOnExist("Questie")) then
+			return false
+		end
+		if C_AddOns.GetAddOnEnableState then
+			local state = C_AddOns.GetAddOnEnableState("Questie", UnitGUID("player"))
+			return state == nil or state > 0
+		end
+		return true
+	end
+	if type(host.SetTarget) == "function" and type(host.GetTarget) == "function" and QuestieEnabled() then
+		local target = Settings.RegisterProxySetting(
+			page,
+			"ShortestPathForever_trackerTarget",
+			Settings.VarType.String,
+			L["Tracker to attach to"],
+			"game",
+			function()
+				return host.GetTarget()
+			end,
+			function(value)
+				host.SetTarget(value)
+			end
+		)
+		local targets = Secure(Settings.CreateControlTextContainer)()
+		Secure(targets.Add)(targets, "game", L["Game quest tracker"])
+		Secure(targets.Add)(targets, "questie", L["Questie tracker"])
+		Settings.RegisterInitializer(
+			page,
+			Secure(Settings.CreateDropdownInitializer)(
+				target,
+				Secure(GenerateClosure)(targets.GetData, targets),
+				-- luacheck: push ignore 631
+				L["Which quest tracker the shared Forever tracker sits under. Questie hides the game's tracker and shows its own, so pick Questie's to keep journey steps with your quests."]
+				-- luacheck: pop
+			)
+		)
+	end
 	-- Lock keeps the detached column where it is: the grip ignores drag while it is on. Off by default, and safe to
 	-- toggle in combat, since it only writes the saved switch.
 	local lock = Settings.RegisterProxySetting(
