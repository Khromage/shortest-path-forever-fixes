diff --git a/tests/tracker_questie_spec.lua b/tests/tracker_questie_spec.lua
new file mode 100644
index 0000000..43c349a
--- /dev/null
+++ b/tests/tracker_questie_spec.lua
@@ -0,0 +1,209 @@
+-- The column can follow Questie's tracker instead of the game's: Questie hides the game's quest tracker and lists the
+-- quests in Questie_BaseFrame, so "under the quest tracker" is measured from that frame once the player picks it.
+-- The column is placed on UIParent by coordinates and never anchored to Questie's frame.
+local harness = dofile("tests/tracker_host_harness.lua")
+
+-- Questie's frame as the host may use it: its place, its scale, whether it is shown, and a script hook.
+local rect = { left = 700, top = 600, bottom = 350, shown = true }
+local hooks = {}
+local reads = {
+	GetLeft = function()
+		return rect.left
+	end,
+	GetTop = function()
+		return rect.top
+	end,
+	GetBottom = function()
+		return rect.bottom
+	end,
+	GetEffectiveScale = function()
+		return 1
+	end,
+	IsShown = function()
+		return rect.shown
+	end,
+	HookScript = function(_, event, fn)
+		hooks[event] = fn
+	end,
+}
+local questie = setmetatable({}, {
+	__index = function(_, key)
+		return reads[key] or error("the host used Questie's " .. tostring(key), 2)
+	end,
+	__newindex = function(_, key)
+		error("the host wrote Questie's " .. tostring(key), 2)
+	end,
+})
+
+local function At(ctx, corner, x, y)
+	local point = ctx.host.point
+	return point[1] == corner and point[2] == ctx.parent and point[3] == "BOTTOMLEFT" and point[4] == x and point[5] == y
+end
+local function UnderGame(ctx)
+	return At(ctx, "TOPLEFT", ctx.nativeRect.left, ctx.nativeRect.line)
+end
+-- Questie's last line moved, or Questie placed its tracker again: the hooks on its frame hear both.
+local secure = {}
+local function Resize()
+	hooks.OnSizeChanged(questie)
+end
+local function Move()
+	secure.SetPoint(questie)
+end
+-- A second of game time: the queued timers run, then the layouts they queued.
+local function Tick(ctx)
+	ctx.drain()
+	ctx.drain()
+end
+
+local t = harness.new({ hostSettings = { attached = false } })
+rawset(t.env, "hooksecurefunc", function(frame, name, fn)
+	assert(frame == questie, "only Questie's frame is hooked")
+	secure[name] = fn
+end)
+local check, api = t.check, t.ns.TrackerHost
+check(api.GetTarget() == "game" and UnderGame(t), "the column follows the game's tracker until told otherwise")
+
+-- Picked before Questie has built its tracker, the column stays by the game's and checks once a second.
+api.SetTarget("questie")
+Tick(t)
+check(api.GetTarget() == "questie" and t.hostSettings.target == "questie", "the choice is saved")
+check(UnderGame(t), "with no Questie tracker yet, the game's tracker is still the place")
+check(t.pending() == 1, "and one check is waiting for Questie's frame")
+Tick(t)
+check(UnderGame(t) and t.pending() == 1, "a check that finds nothing waits again")
+
+rawset(t.env, "Questie_BaseFrame", questie)
+Tick(t)
+check(At(t, "TOPLEFT", 700, 350), "once Questie's tracker exists the column sits under its last line")
+check(t.pending() == 0, "and the checking stops")
+check(t.first.available == 600 - 10, "the sections lay out in the room from Questie's top")
+check(type(hooks.OnShow) == "function" and type(hooks.OnHide) == "function", "its show and hide are hooked")
+check(type(hooks.OnSizeChanged) == "function", "and its size")
+check(secure.SetPoint and secure.StopMovingOrSizing, "and the calls that move it")
+for _, f in ipairs(t.frames) do
+	local point = f.point
+	check(not point or point[2] ~= questie, "nothing is anchored to Questie's frame")
+end
+
+-- A quest added or dropped moves Questie's last line; a drag moves the whole frame.
+rect.bottom = 300
+Resize()
+check(At(t, "TOPLEFT", 700, 300), "the column follows Questie's last line")
+rect.left, rect.top, rect.bottom = 200, 900, 640
+Move()
+check(At(t, "TOPLEFT", 200, 640), "and Questie's tracker wherever it is dragged")
+
+-- Questie clears its points before it sets them again; a tracker with no rect moves nothing.
+local saved = { rect.left, rect.top, rect.bottom }
+rect.left, rect.top, rect.bottom = nil, nil, nil
+Resize()
+check(At(t, "TOPLEFT", 200, 640), "a Questie tracker with no place holds the column where it was")
+rect.left, rect.top, rect.bottom = saved[1], saved[2], saved[3]
+
+-- No room under the list: left of Questie's tracker, by coordinates.
+rect.bottom = t.host:GetHeight() - 1
+Resize()
+check(At(t, "TOPRIGHT", 200, 900), "a column that does not fit under the list sits left of Questie's tracker")
+rect.bottom = 640
+Resize()
+check(At(t, "TOPLEFT", 200, 640), "and returns under it when it fits")
+
+-- Questie hides its tracker with nothing tracked: the column takes the tracker's top, as it does for the game's.
+rect.shown = false
+hooks.OnHide(questie)
+Tick(t)
+check(At(t, "TOPLEFT", 200, 900), "a hidden Questie tracker leaves the column at its top")
+rect.shown = true
+hooks.OnShow(questie)
+Tick(t)
+check(At(t, "TOPLEFT", 200, 640), "and showing it puts the column under the list again")
+
+-- The Left place follows the same tracker.
+api.SetPlacement("left")
+Tick(t)
+check(At(t, "TOPRIGHT", 200, 900), "Left is left of Questie's tracker")
+api.SetPlacement("under")
+Tick(t)
+
+-- Back to the game's tracker.
+api.SetTarget("game")
+Tick(t)
+check(t.hostSettings.target == nil and UnderGame(t), "picking the game's tracker returns the column to it")
+api.SetTarget("elsewhere")
+check(api.GetTarget() == "game", "an unknown target is ignored")
+
+-- Over Questie's tracker: the column's bottom left corner on the tracker's top left corner.
+rect.left, rect.top, rect.bottom = 200, 600, 300
+api.SetTarget("questie")
+api.SetTargetSide("above")
+Tick(t)
+check(api.GetTarget() == "questie" and api.GetTargetSide() == "above", "the side is its own choice")
+check(t.hostSettings.above == true, "and is saved")
+check(At(t, "BOTTOMLEFT", 200, 600), "the column sits on top of Questie's tracker")
+check(t.first.available == 1080 - 600 - 10, "the sections lay out in the room over Questie's tracker")
+rect.bottom = 100
+Resize()
+check(At(t, "BOTTOMLEFT", 200, 600), "Questie's list growing does not move it")
+rect.top, rect.bottom = 700, 200
+Resize()
+check(At(t, "BOTTOMLEFT", 200, 700), "and it follows the tracker's top")
+rect.top = 1080 - t.host:GetHeight() + 1
+Resize()
+check(At(t, "TOPRIGHT", 200, rect.top), "with no room over the tracker it sits left of it")
+rect.top, rect.bottom = 900, 640
+api.SetTarget("game")
+Tick(t)
+check(UnderGame(t) and api.GetTargetSide() == "above", "the game's tracker has no side, and Questie's is kept")
+api.SetTarget("questie")
+Tick(t)
+check(At(t, "BOTTOMLEFT", 200, 900), "so the column returns over Questie's tracker")
+
+-- A drag moves Questie's frame with no call: the column follows each frame from the drag's start to its end.
+local function DragFrame()
+	for _, f in ipairs(t.frames) do
+		if f.scripts.OnUpdate then
+			return f
+		end
+	end
+end
+local down = true
+rawset(t.env, "IsMouseButtonDown", function()
+	return down
+end)
+check(DragFrame() == nil, "nothing runs each frame while Questie's tracker is still")
+secure.StartMoving(questie)
+local drag = DragFrame()
+check(drag ~= nil, "a drag starts the frame by frame follow")
+rect.left, rect.top = 300, 800
+drag.scripts.OnUpdate(drag)
+check(At(t, "BOTTOMLEFT", 300, 800), "the column moves with Questie's tracker during the drag")
+rect.left, rect.top = 350, 850
+secure.StopMovingOrSizing(questie)
+check(At(t, "BOTTOMLEFT", 350, 850) and DragFrame() == nil, "the drop places it and ends the follow")
+secure.StartSizing(questie)
+down = false
+drag.scripts.OnUpdate(drag)
+check(DragFrame() == nil, "a mouse button released ends it as well")
+rect.left, rect.top, rect.bottom = 200, 900, 640
+
+api.SetTargetSide("under")
+Tick(t)
+check(t.hostSettings.above == nil and At(t, "TOPLEFT", 200, 640), "picking Under puts it under the list again")
+api.SetTargetSide("sideways")
+check(api.GetTargetSide() == "under", "an unknown side is ignored")
+
+-- Combat places nothing; the layout after it does.
+api.SetTarget("questie")
+Tick(t)
+t.setCombat(true)
+rect.bottom = 500
+Resize()
+check(At(t, "TOPLEFT", 200, 640), "combat holds the column where it was")
+t.setCombat(false)
+t.fire("PLAYER_REGEN_ENABLED")
+Tick(t)
+check(At(t, "TOPLEFT", 200, 500), "and the layout after combat catches up")
+
+rawset(t.env, "Questie_BaseFrame", nil)
+print(("tracker_questie_spec: %d checks passed"):format(t.checks()))
