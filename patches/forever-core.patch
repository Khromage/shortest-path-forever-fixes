+-- Questie hides the game's quest tracker and draws its own list in Questie_BaseFrame, wherever the player put it. With
+-- the "questie" target, Under and Left are measured from that frame instead. It is created a while after login and
+-- only when Questie's tracker is on, so it is looked up on each use; without it the game's tracker is the place.
+---@return Frame?
+local function QuestieTracker()
+	local frame = rawget(_G, "Questie_BaseFrame")
+	if type(frame) == "table" and type(frame.GetLeft) == "function" then
+		return frame
+	end
+end
+-- The tracker the column follows.
+---@return Frame
+local function Tracker()
+	return Settings().target == "questie" and QuestieTracker() or ObjectiveTrackerFrame
+end
